# Overlay for a device that HOLDS a TLS connection open. Use with the others:
#   MOGWAI_WIFI=1 idf.py \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.wifi;sdkconfig.tls" build
#
# mbedTLS holds its record buffers for the LIFE of a connection, so on a
# one-connection device IN_CONTENT_LEN is held memory, not a transient.
# Measured, held-open session against a real server:
#
#   IN=16384 (IDF default)   holds 34,632 B   worst-case free 17,972 B
#   IN=8192                  holds 27,056 B   worst-case free 28,776 B
#   IN=4096                  HANDSHAKE FAILS  mbedtls_ssl_handshake -0x7200
#
# 4096 is not a tuning choice, it is a broken build: the server sends records
# larger than the buffer and every handshake is rejected.
#
# THIS IS SERVER-DEPENDENT. 8192 worked against the endpoint measured here; a
# server that emits full 16 KB TLS records will fail exactly as 4096 did.
# Validate against the endpoint you actually talk to before shipping it. The
# standards-based fix is the max_fragment_length extension, which needs server
# support that most do not have.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
