# Overlay for any networked build (MOGWAI_WIFI=1 or MOGWAI_PROBE=1):
#   MOGWAI_WIFI=1 idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.wifi" build
#
# ---- WiFi driver buffers -----------------------------------------------------
# Measured: recovers ~1 chunk of index residency with the full netif+lwIP stack
# present. NOT free — fewer buffers means packet loss under sustained
# throughput. Fine for a device that receives occasional short utterances;
# validate before using it under load.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# ---- mbedTLS record buffers --------------------------------------------------
# mbedTLS holds these for the LIFE of a connection, so on a device that keeps a
# session open they are HELD memory, not a transient. Measured, held-open
# session against a real server:
#
#   IN=16384 (IDF default)   holds 34,632 B   worst-case free 17,972 B
#   IN=8192                  holds 27,056 B   worst-case free 28,776 B
#   IN=4096                  HANDSHAKE FAILS  mbedtls_ssl_handshake -0x7200
#
# 4096 is not a tuning choice, it is a broken build: the server sends records
# larger than the buffer and every handshake is rejected.
#
# THIS IS SERVER-DEPENDENT. 8192 worked against the endpoint measured here; a
# server emitting full 16 KB TLS records will fail exactly as 4096 did.
# Validate against the endpoint you actually talk to. The standards-based fix is
# the max_fragment_length extension, which needs server support most lack.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# ---- WiFi IRAM speed optimisation: OFF ---------------------------------------
# These copy WiFi/RX code into IRAM to raise throughput. On this device IRAM is
# worth more as INDEX STORAGE than as WiFi speed: the index is uint32_t
# throughout, so lift.c can place chunks in the 32-bit-only pool that malloc
# cannot reach — and packet buffers, which need byte access, never could.
# Measured, WiFi associated, full netif+lwIP+TLS:
#
#   IRAM_OPT on    2944/3840 resident (76%)   2432 DRAM + 512 IRAM   9.19 ms
#   IRAM_OPT off   3200/3840 resident (83%)   2432 DRAM + 768 IRAM   8.42 ms
#
# DRAM is IDENTICAL either way. The whole gain is IRAM that WiFi was holding for
# speed, handed to a workload that can physically use it. TLS unaffected:
# worst-case free 27,644 B, handshake still returns HTTP 200.
#
# NOT free: WiFi code now runs from flash cache, so ISR latency is higher and
# throughput is lower. Measured under light traffic only — validate before using
# it on a device that moves real data.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
